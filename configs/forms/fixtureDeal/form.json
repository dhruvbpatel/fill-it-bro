{
  "formId": "fixtureDeal",
  "urlTemplate": "http://localhost:4300/deal/{dealId}",
  "widgetProfiles": "./widget-profiles.json",
  "sections": [
    {
      "id": "deal",
      "tab": { "locator": { "role": { "name": "Deal", "role": "tab" } } },
      "reveal": [
        { "action": "click", "locator": { "role": { "name": "Add fees", "role": "button" } } }
      ],
      "fields": [
        {
          "fieldId": "issuerName",
          "control": "searchSelect",
          "locator": { "formControlName": "issuerName" },
          "profile": "fixtureSearchSelect"
        },
        {
          "fieldId": "dealAmount",
          "control": "text",
          "locator": { "formControlName": "dealAmount" }
        },
        {
          "fieldId": "currency",
          "control": "select",
          "locator": { "formControlName": "currency" }
        },
        {
          "fieldId": "settlementDate",
          "control": "date",
          "locator": { "formControlName": "settlementDate" }
        },
        {
          "fieldId": "isConfidential",
          "control": "checkbox",
          "locator": { "formControlName": "isConfidential" }
        },
        {
          "fieldId": "feeType",
          "control": "select",
          "locator": { "formControlName": "feeType" }
        }
      ],
      "grids": []
    },
    {
      "id": "parties",
      "tab": { "locator": { "role": { "name": "Parties", "role": "tab" } } },
      "fields": [],
      "grids": [
        {
          "groupId": "parties",
          "control": "agGrid",
          "locator": { "css": "[data-testid=\"parties-grid\"]" },
          "addRow": { "locator": { "role": { "name": "Add row", "role": "button" } } },
          "columns": [
            { "fieldId": "partyName", "colId": "partyName", "control": "text" },
            { "fieldId": "role", "colId": "role", "control": "select" },
            { "fieldId": "amount", "colId": "amount", "control": "text" }
          ]
        }
      ]
    }
  ]
}
