# Local LLM config — copy to `.env` and fill in. NEVER commit `.env`.
# Any OpenAI-compatible provider works: OpenAI, Muse Spark, GLM/Zhipu, OpenRouter, ...
#
#   cp .env.example .env
#
# Real exported environment variables always win over these values.

# Base URL of the OpenAI-compatible API.
# Examples:
#   OpenAI:     https://api.openai.com/v1
#   Muse Spark: https://api.meta.ai/v1
#   GLM/Zhipu:  https://open.bigmodel.cn/api/paas/v4
GATEWAY_BASE_URL=https://api.openai.com/v1

# API key for the provider above. No default on purpose.
GATEWAY_API_KEY=

# Model name as the provider expects it (e.g. gpt-4o, muse-spark-1.3, glm-4.7).
MODEL=gpt-4o

# PROVIDER=openai for any real LLM, PROVIDER=fake for canned responses (no key needed).
PROVIDER=openai

# Local ports / URLs.
PORT=8787
FIB_SERVICE_URL=http://localhost:8787
