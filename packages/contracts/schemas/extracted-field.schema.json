{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fib.local/schemas/extracted-field",
  "title": "ExtractedField",
  "description": "LLM structured-output boundary object: every property is required (nullable where absent), per OpenAI strict-schema mode.",
  "type": "object",
  "properties": {
    "fieldId": { "type": "string" },
    "value": { "type": ["string", "number", "boolean", "null"] },
    "valueType": { "type": "string" },
    "status": { "type": "string", "enum": ["found", "notFound", "ambiguous"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sourceId": { "type": ["string", "null"] },
    "citations": { "type": "array", "items": { "$ref": "citation-ref.schema.json" } },
    "reason": { "type": ["string", "null"] }
  },
  "required": [
    "fieldId",
    "value",
    "valueType",
    "status",
    "confidence",
    "sourceId",
    "citations",
    "reason"
  ],
  "additionalProperties": false
}
