{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fib.local/schemas/extraction-request",
  "title": "ExtractionRequest",
  "type": "object",
  "properties": {
    "formId": { "type": "string" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/Source" }
    }
  },
  "required": ["formId", "sources"],
  "additionalProperties": false,
  "$defs": {
    "Source": {
      "type": "object",
      "properties": {
        "sourceId": { "type": "string" },
        "pages": { "type": "array", "items": { "$ref": "#/$defs/Page" } }
      },
      "required": ["sourceId", "pages"],
      "additionalProperties": false
    },
    "Page": {
      "type": "object",
      "properties": {
        "mergedPage": { "type": "integer", "minimum": 1 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/Item" } }
      },
      "required": ["mergedPage", "items"],
      "additionalProperties": false
    },
    "Item": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" }
      },
      "required": ["id", "text"],
      "additionalProperties": false
    }
  }
}
