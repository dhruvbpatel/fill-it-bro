{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fib.local/schemas/agent-step-request",
  "title": "AgentStepRequest",
  "type": "object",
  "properties": {
    "goal": { "type": "string" },
    "fieldSpec": {
      "type": "object",
      "properties": {
        "fieldId": { "type": "string" },
        "description": { "type": "string" },
        "expectedType": { "type": "string" }
      },
      "required": ["fieldId", "description"],
      "additionalProperties": false
    },
    "a11ySnapshot": { "type": "string" },
    "history": { "type": "array", "items": { "$ref": "#/$defs/HistoryEntry" } }
  },
  "required": ["goal", "fieldSpec", "a11ySnapshot", "history"],
  "additionalProperties": false,
  "$defs": {
    "HistoryEntry": {
      "type": "object",
      "properties": {
        "toolCall": { "$ref": "agent-step-response.schema.json" },
        "observation": { "type": ["string", "null"] }
      },
      "required": ["toolCall", "observation"],
      "additionalProperties": false
    }
  }
}
