{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fib.local/schemas/resolved-field",
  "title": "ResolvedField",
  "description": "Standalone flat schema (deliberately not composed via allOf on ExtractedField, whose additionalProperties:false CitationRef items would conflict with Citation items in the same allOf).",
  "type": "object",
  "properties": {
    "fieldId": { "type": "string" },
    "value": { "type": ["string", "number", "boolean", "null"] },
    "valueType": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["found", "notFound", "ambiguous", "unverifiedCitation"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "sourceId": { "type": ["string", "null"] },
    "reason": { "type": ["string", "null"] },
    "citations": { "type": "array", "items": { "$ref": "citation.schema.json" } }
  },
  "required": [
    "fieldId",
    "value",
    "valueType",
    "status",
    "confidence",
    "sourceId",
    "reason",
    "citations"
  ],
  "additionalProperties": false
}
